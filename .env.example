# Django settings
# Copy this file to .env and customize values for your deployment.

SECRET_KEY=django-insecure-teaching-key
DEBUG=True

# Single-host default. Override with per-service URLs when services run on separate servers.
BASE_URL=http://127.0.0.1:8000
HR_BASE_URL=http://127.0.0.1:8000
EXTERNAL_JOBS_BASE_URL=http://127.0.0.1:8000
EMPLOYEE_SYSTEM_BASE_URL=http://127.0.0.1:8000

# API tokens for service-to-service authentication
HR_API_TOKEN=class-hr-token
EXTERNAL_JOBS_API_TOKEN=class-external-jobs-token
EMPLOYEE_SYSTEM_API_TOKEN=class-employee-system-token

# Optional external credentials
GEMINI_API_KEY=
